# Copy to .env. Nothing here is a secret.
#
# Where the original photographs are served from. src/assets/photos is 6.62 GB
# and is not in the repository; the originals live in a public Cloudflare R2
# bucket, keyed by the file names in src/data/photos.json
# (<base>/originals/<photoId>-<n>.png). The bird panel's "view the original"
# link is built from this, so it is compiled into the shipped JavaScript and
# is public by definition — which is why the deploy workflow sets it in the
# open (.github/workflows/deploy.yml) rather than as a repository secret.
#
# Leave it unset and the site simply does not offer the link.
PUBLIC_ORIGINALS_BASE=https://pub-6cf8120c2be142589cd5b84483c3bb6e.r2.dev

# Google Analytics 4, the site's measurement ID. Not a secret: it ships in the
# HTML of all 397 pages and anyone can read it out of the page source, which is
# why the deploy workflow sets it in the open too (.github/workflows/deploy.yml)
# rather than as a repository secret. src/lib/analytics.ts is the one place the
# whole arrangement is written down.
#
# Leave it unset and no tag is emitted at all — no script, no request to
# Google, no change to the page. That is what a local `npm run dev` should be,
# so the line below stays commented in `.env`; uncomment it only to check the
# wiring, and comment it back before you go on working.
#PUBLIC_GA_ID=G-DMKKDJ3JNM
