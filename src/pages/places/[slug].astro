---
/**
 * One place — the pin bloomed open.
 *
 * Arriving from the map, the pin keeps its view-transition name and stays
 * put while the birds it stands for fan out into the grid beside it. Typed
 * straight into the address bar it is an ordinary page: the same map, the
 * same list, ordered by first spotting so it reads as a trip report.
 *
 * Hovering a bird in the grid lights every other pin it was seen at — the
 * script that does it lives in MapStage.astro.
 */
import Base from '../../layouts/Base.astro';
import BirdPanel from '../../components/BirdPanel.astro';
import MapStage from '../../components/MapStage.astro';
import MapPlaceGrid from '../../components/MapPlaceGrid.astro';
import { formatDate } from '../../lib/flock';
import { places, placesIn, placeBySlug, placeSlugsOf } from '../../lib/mapView';
import { withBase } from '../../lib/paths';

export function getStaticPaths() {
  return places.map((place) => ({ params: { slug: place.slug } }));
}

const { slug } = Astro.params;
const place = placeBySlug.get(slug!)!;
const pins = placesIn(place.space);
const backHref = withBase(place.space === 'triangle' ? '/places#triangle' : '/places');

const span =
  place.firstDate && place.lastDate && place.firstDate !== place.lastDate
    ? `${formatDate(place.firstDate)} → ${formatDate(place.lastDate)}`
    : formatDate(place.firstDate ?? '');

const shared = place.birds.filter((b) => (b.locationIds ?? []).length > 1).length;

/*
 * How many of this place's birds have a sighting the map cannot show
 * (TODO C5). A pin lives on one sheet, so from here their other pins are
 * off-screen and unlightable; those tiles carry a ↗ instead, and this is
 * the sentence that says so once rather than 30 times.
 * 298 of the 584 tiles across the 37 place pages are in that position.
 */
const away = place.birds.filter((b) =>
  placeSlugsOf(b).some((s) => {
    const p = placeBySlug.get(s);
    return p && p.space !== place.space;
  }),
).length;
const otherMap = place.space === 'triangle' ? 'the US map' : 'the home patch';

---

<Base
  title={`${place.name} · Birding Checklist`}
  description={`${place.count} birds recorded at ${place.name}.`}
>
  <section class:list={['page', 'place', place.count <= 3 && 'place--few']}>
    <header class="page__head">
      <p class="eyebrow">
        <a class="place__up" href={backHref}>Where</a> · {place.space === 'triangle' ? 'home patch' : 'on the road'}
      </p>
      <h1 class="display">{place.name}</h1>
      <p class="lede">
        {place.count} {place.count === 1 ? 'bird' : 'birds'}{span ? ` · ${span}` : ''}
        {place.loc.placeNote && <span class="place__note">{place.loc.placeNote}</span>}
      </p>
    </header>

    <div class="place__body">
      <div class="place__map">
        <MapStage space={place.space} places={pins} activeSlug={place.slug} />
        <div class="place__foot">
          {/* Always in flow, never `hidden`: it holds its two lines empty so
              that hovering a bird cannot move the link below it (TODO C5).
              MapStage's script fills it and empties it.

              Deliberately not a live region. It restates, for the eye that
              is on the map, what the hovered tile's own ↗ link already says
              in its label ("Canada Goose: 10 places, 7 of them on the US
              map") — announcing it again on every pointer crossing would be
              chatter, not information. */}
          <p class="map-else" data-map-else></p>
          {/* Two sentences, and only the first one needs a pointer. A phone
              cannot hover, and on this page the ↗ sentence is the *only*
              explanation of what the arrow on a tile means — so when the two
              were welded together, the instruction and the legend were lost
              together on the devices that most need the legend (AUDIT2 §5.2).
              The hover half now states the fact instead of the gesture where
              there is no hover to offer; the arrow half is unconditional. */}
          <p class="place__hint">
            {shared > 0 ? (
              <>
                <span class="hint--hover">Hover a bird: {shared} of these were seen
                  {' '}somewhere else too, and those pins light up.</span>
                <span class="hint--flat">{shared} of these were seen somewhere else too.</span>
              </>
            ) : (
              <span class="hint--hover">Hover a bird to find it on the map.</span>
            )}
            {away > 0 && (
              <>
                {' '}A ↗ means the rest of that bird's map is on {otherMap} — {away} of
                {' '}{place.count} here — and follows it to the bird's own page.
              </>
            )}
          </p>
          <a class="place__back" href={backHref}><span aria-hidden="true">←</span> the whole map</a>
        </div>
      </div>

      <div class="place__grid">
        <MapPlaceGrid place={place} space={place.space} />
      </div>
    </div>
  </section>

  <BirdPanel birds={place.birds} />
</Base>

<style>
  /*
   * The head, and why it is not the same head as every other view.
   *
   * A view's <h1> is one word — "Where", "When" — and `--fs-display` was
   * drawn for exactly that. A place's <h1> is a proper name of up to 43
   * characters, and inside `.page__head`'s 62ch prose measure (413 px of it
   * at 1440, once the gutters are off) the display face ran the 37 names
   * over one, two, three and four lines. Everything under the title then
   * started at a different y on every place page: measured at 1440 the map's
   * top edge was 292 / 314 / 363 / 433 / 504 px and the grid's first cell
   * followed it. The map is what you move between place pages with, so the
   * page jumped under the pointer exactly when it was on the map — which is
   * what the owner reported ("目前地点标题行数不一致所以导致排版出问题").
   *
   * Three measured changes, in order:
   *
   * 1. The title leaves the prose measure. 62ch is right for the lede and
   *    far too narrow for 54 px type; the head drops its cap and the title
   *    takes its own, below.
   *
   * 2. The title takes a place-page size instead of --fs-display. This is
   *    not a change to the type scale (which belongs to global.css and is
   *    left alone) — it is one element choosing a size, and it puts the
   *    three registers in the right order: the view's wordmark at 70 px,
   *    a place's name at 54, a bird's name at 34.
   *
   * 3. The title then holds two lines whether it needs them or not, and the
   *    place note under the lede holds its own two, so the head is one
   *    height on all 37 pages. Same argument as `.map-else` below (TODO C5)
   *    and the same result: the measured movement is 0 px.
   */
  .page__head {
    /* 62ch is the lede's measure, not the title's; the title's is set on
       .display and the lede keeps its own 46ch from global.css */
    max-width: none;
    /* the container `100cqi` below is read from: the head's inline size */
    container-type: inline-size;
  }

  /*
   * Two lines, for every one of the 37 names, at every width.
   *
   * Measured in the real face by binary search: the longest name,
   * "University of North Carolina at Chapel Hill", needs 10.50 em of measure
   * before the browser will break it into two lines rather than three
   * (next worst: Mason Farm Biological Reserve at 8.49 em). 11 em is that
   * with 4.8% in hand for the fallback face.
   *
   * So the rule is "11 em must fit", and the size is whichever is smaller:
   * the place-page display size, or an eleventh of the measure available.
   * Above ~520 px of viewport the first term wins and the title is at its
   * full size; below it the second takes over, which is what keeps the long
   * names to two lines on a phone (30.4 px at 390, 28.8 at 360) where
   * --fs-display's 41.6 px floor would have made three.
   */
  .display {
    font-size: min(clamp(1.9rem, 4.9vw, 3.4rem), 100cqi / 11);
    max-width: 11em;
    /* line-height is 1, so 2em is exactly two lines — reserved, not enforced */
    min-height: 2em;
    /*
     * The reserved line sits *above* a one-line name, not below it. Both
     * ways hold the body still; this way the spare line lands under the
     * eyebrow, where it reads as air over a title, instead of between the
     * title and its own lede, where it reads as a gap. "Tampa, FL" and
     * "Patterson Place & Five Oaks" then share the same baseline for their
     * last line, which is the line the lede is answering.
     */
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    /* a two-line name breaks in the middle rather than leaving one orphan
       word under a full line; it cannot add a line, only even one out */
    text-wrap: balance;
  }

  .place__note {
    display: block;
    font-size: var(--fs-small);
    color: var(--ink-faint);
    /*
     * The other half of the head's height. The note is one line for 33 of
     * the 37 places and two for the rest — 金玉公寓's parenthetical, Lake
     * Betz, Jordan Lake, Beaver Marsh — and at 360 px a fifth name joins
     * them. Two is the measured maximum at every width down to 360, so it
     * holds two and the lede is as tall on every page.
     */
    min-height: 2lh;
  }

  /* Paper has no pointer to move between pages, so nothing needs reserving:
     a printed place page gets its title at whatever height it wants and its
     note at whatever height it is. (global.css §7 already pins the printed
     display size, which is why the size above is not repeated here.) */
  @media print {
    .display { max-width: none; min-height: 0; }
    .place__note { min-height: 0; }
  }

  .place__up {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  .place__up:hover { border-bottom-color: var(--ink-soft); }

  .place__body {
    display: grid;
    gap: clamp(28px, 4vw, 56px);
    padding: 0 var(--gutter);
  }

  .place__map { min-width: 0; }
  .place__grid { min-width: 0; }

  .place__foot { min-width: 0; }

  .map-else,
  /* The gesture half of the hint, and its no-gesture twin. `hover: hover`
     is the one query that asks what the pointer can actually do. */
  .hint--hover { display: none; }
  .hint--flat { display: inline; }
  @media (hover: hover) {
    .hint--hover { display: inline; }
    .hint--flat { display: none; }
  }

  .place__hint {
    margin: 0.9em 0 0;
    font-family: var(--sans);
    font-size: var(--fs-micro);
    letter-spacing: 0.04em;
    line-height: 1.5;
    color: var(--ink-faint);
  }
  /*
   * Two lines, reserved (TODO C5). Hovering a bird used to grow this line
   * from nothing to as much as four lines, which pushed "← the whole map"
   * 75 px down the sticky column at 1440 — under a pointer that may well
   * have been on its way there. MapStage now budgets the text to fit two
   * lines and this box holds those two lines whether or not they are full,
   * so the measured movement is 0 px.
   */
  .map-else {
    color: var(--ink-soft);
    min-height: 3em;
  }

  .place__back {
    display: inline-block;
    margin-top: 1.2em;
    font-family: var(--sans);
    font-size: var(--fs-micro);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.2em;
  }
  .place__back:hover { color: var(--ink); border-bottom-color: var(--ink-soft); }

  @media (min-width: 900px) {
    .place__body {
      grid-template-columns: minmax(300px, 38%) minmax(0, 1fr);
      align-items: start;
    }
    .place__map {
      position: sticky;
      top: clamp(16px, 4vh, 48px);
    }

    /*
     * A sticky column sets its own children down, so it owes the compass its
     * corner (lib/README §9): the map's footnotes are the only part of this
     * column that reaches the bottom of the window, and they step inboard by
     * the compass reserve rather than sit underneath it.
     */
    .place__foot { margin-left: var(--compass-safe); }

    /* one or two birds do not need half the window to sit in: both columns
       shrink to what they hold and the pair centres on the page */
    .place--few .place__body {
      grid-template-columns: minmax(280px, 34%) minmax(0, max-content);
      justify-content: center;
    }
    .place--few :global(.bloom) { grid-template-columns: repeat(auto-fill, 132px); }
  }
</style>
